# ═══════════════════════════════════════════════════════════
# INFRASTRUCTURE LAYER CONFIGURATION
# ═══════════════════════════════════════════════════════════

# MySQL Database Configuration (matches docker-compose.yml)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ticketbox
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_HOST=mysql
MYSQL_PORT=3306

# MongoDB Configuration (matches docker-compose.yml)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin
MONGO_INITDB_DATABASE=ticketbox
MONGO_PORT=27017
MONGO_HOST=mongodb

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ Configuration (matches docker-compose.yml)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ═══════════════════════════════════════════════════════════
# SERVICE PORTS (matches docker-compose.yml)
# ═══════════════════════════════════════════════════════════
GATEWAY_PORT=8080
IDENTITY_PORT=8081
EVENT_PORT=8082
BOOKING_PORT=8083
TICKET_PORT=8084
PAYMENT_PORT=8085
NOTIFICATION_PORT=8087
WEB_PORT=3000

# ═══════════════════════════════════════════════════════════
# SPRING BOOT - DATASOURCE CONFIGURATION
# ═══════════════════════════════════════════════════════════
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/ticketbox?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# ═══════════════════════════════════════════════════════════
# SPRING BOOT - HIBERNATE CONFIGURATION
# ═══════════════════════════════════════════════════════════
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQL8Dialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# ═══════════════════════════════════════════════════════════
# SPRING BOOT - GENERAL CONFIGURATION
# ═══════════════════════════════════════════════════════════
SPRING_APPLICATION_NAME=event-ticketing-service
SPRING_ENV=dev
SPRING_PROFILES_ACTIVE=dev

# ═══════════════════════════════════════════════════════════
# REDIS CONFIGURATION (for Event & Seat services)
# ═══════════════════════════════════════════════════════════
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_TIMEOUT=60000

# ═══════════════════════════════════════════════════════════
# RABBITMQ CONFIGURATION (for Booking & other services)
# ═══════════════════════════════════════════════════════════
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# ═══════════════════════════════════════════════════════════
# LOGGING CONFIGURATION
# ═══════════════════════════════════════════════════════════
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_FIT_IUH=DEBUG
LOG_LEVEL=debug

# ═══════════════════════════════════════════════════════════
# FRONTEND CONFIGURATION
# ═══════════════════════════════════════════════════════════
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_TIMEOUT=30000

# ═══════════════════════════════════════════════════════════
# JWT & SECURITY (for Identity Service)
# ═══════════════════════════════════════════════════════════
JWT_SECRET=your_secret_key_change_in_production
JWT_EXPIRATION=3600000

# ═══════════════════════════════════════════════════════════
# EMAIL CONFIGURATION (for Notification Service)
# ═══════════════════════════════════════════════════════════
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@ticket-system.com

# ═══════════════════════════════════════════════════════════
# DOCKER & REGISTRY CONFIGURATION
# ═══════════════════════════════════════════════════════════
REGISTRY=ghcr.io
REGISTRY_USERNAME=your_registry_user
REGISTRY_PASSWORD=your_registry_password

# ═══════════════════════════════════════════════════════════
# TIMEZONE
# ═══════════════════════════════════════════════════════════
TIMEZONE=Asia/Ho_Chi_Minh
AWS_S3_BUCKET_NAME=your_bucket_name
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=your_aws_region
# ═══════════════════════════════════════════════════════════
# MOMO CONFIGURATION
# ═══════════════════════════════════════════════════════════
PAYMENT_MOMO_IPN_HOST=your_ipn_host
# ═══════════════════════════════════════════════════════════
# AI CONFIGURATION
# ═══════════════════════════════════════════════════════════
GEMINI_API_KEY=your_api_key
GROQ_API_KEY=your_api_key
GATEWAY_CORS_ALLOW_ORIGIN=https://event-ticketing-platform-deploy.vercel.app