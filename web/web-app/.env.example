# Frontend runtime config
# Use this for local dev and Vercel deployment.

# Public API base used by the frontend build/runtime.
# Examples:
# /api
# https://your-forward-address/api
VITE_API_BASE_URL=/api

# Optional explicit chat base URL.
# If omitted, the app uses VITE_API_BASE_URL + /chat.
# Example:
# https://your-forward-address/api/chat
VITE_CHAT_BASE_URL=

# Used for public event URLs and QR code links.
# Leave empty to fall back to the current browser origin.
# Example:
# https://your-vercel-domain.vercel.app
VITE_PUBLIC_SITE_URL=

# Local Vite dev proxy target.
# Example:
# https://your-forward-address
VITE_DEV_BACKEND_TARGET=https://localhost:8443
